# ==========================================================
# Matemática pra Todos
# Arquivos que não devem ser versionados
# ==========================================================

# --------------------------
# Variáveis de ambiente
# --------------------------
.env
.env.local
.env.*.local

# --------------------------
# Python
# --------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Ambientes virtuais
.venv/
venv/
env/

# --------------------------
# Frontend / Node
# --------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------
# IDE / Editores
# --------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --------------------------
# Sistema operacional
# --------------------------
.DS_Store
Thumbs.db

# --------------------------
# Logs
# --------------------------
*.log
logs/

# --------------------------
# Temporários
# --------------------------
*.tmp
*.temp
.cache/

# --------------------------
# Banco / backups locais
# --------------------------
*.dump
*.backup
*.sql.gz

# --------------------------
# Docker - configuração local
# --------------------------
docker-compose.override.yml

# --------------------------
# Chaves e certificados privados
# --------------------------
*.pem
*.key
*.p12
*.pfx
